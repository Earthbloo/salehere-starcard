                   "type": "text",
                   "text": "{likes}",
                   "face": "noto",
                   "size": 10,
                   "weight": 700,
                   "color": "ink@0.8",
                   "maxLines": 1,
                   "shrinkTo": 8
                  }
                 ]
                },
                {
                 "type": "row",
                 "if": "$sharesRaw>0",
                 "gap": 2.5,
                 "align": "center",
                 "children": [
                  {
                   "type": "icon",
                   "icon": "ph:share-fat-fill",
                   "w": 10,
                   "h": 10,
                   "tint": "ink@0.8"
                  },
                  {
                   "type": "text",
                   "text": "{shares}",
                   "face": "noto",
                   "size": 10,
                   "weight": 700,
                   "color": "ink@0.8",
                   "maxLines": 1,
                   "shrinkTo": 8
                  }
                 ]
                }
               ]
              }
             ],
             "if": "$viewsRaw.max>0 | $sharesRaw.max>0"
            }
           ]
          }
         }
        ]
       }
      ]
     }
    ]
   }
  ]
 }
}
