       "sigma": 4.5,
       "y": 4,
       "color": "black@0.07"
      }
     },
     {
      "type": "rect",
      "if": "cfg:fill=gradient",
      "radius": 20,
      "gradient": {
       "from": "white@0.25",
       "to": "black@0.22",
       "angle": 45
      }
     },
     {
      "type": "rect",
      "if": "bordered",
      "id": "border",
      "radius": 20,
      "stroke": {
       "color": "kit.border",
       "width": 1.5
      }
     }
    ]
   },
   {
    "type": "stack",
    "if": "cfg:corner=square",
    "children": [
     {
      "type": "stack",
      "if": "!bordered",
      "children": [
       {
        "type": "rect",
        "if": "!cfg:fill=clear",
        "id": "fill",
        "fill": "kit.fill",
        "radius": 20,
        "shadow": {
         "sigma": 4.5,
         "y": 4,
         "color": "black@0.07"
        }
       },
       {
        "type": "rect",
        "if": "cfg:fill=gradient",
        "radius": 20,
        "gradient": {
         "from": "white@0.25",
         "to": "black@0.22",
         "angle": 45
        }
       },
       {
        "type": "rect",
        "if": "bordered",
        "id": "border",
        "radius": 20,
        "stroke": {
         "color": "kit.border",
         "width": 1.5
        }
       }
      ]
     },
     {
      "type": "stack",
      "if": "bordered",
      "children": [
       {
        "type": "rect",
        "if": "!cfg:fill=clear",
        "id": "fill",
        "fill": "kit.fill",
        "radius": 3,
        "shadow": {
         "sigma": 4.5,
         "y": 4,
         "color": "black@0.07"
        }
       },
       {
