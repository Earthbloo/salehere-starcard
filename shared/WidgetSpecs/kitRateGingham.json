  "controls": [
   {
    "type": "checks",
    "label": "ช่องที่แสดง",
    "items": "ratePlatforms",
    "opt": "hide"
   },
   {
    "type": "segment",
    "label": "พื้นหลัง",
    "opt": "fill",
    "options": [
     [
      null,
      "ทึบ"
     ],
     [
      "gradient",
      "ไล่สี"
     ],
     [
      "clear",
      "โปร่ง"
     ]
    ]
   },
   {
    "type": "segment",
    "label": "มุม",
    "opt": "corner",
    "options": [
     [
      null,
      "มน"
     ],
     [
      "square",
      "เหลี่ยม"
     ]
    ],
    "if": "bordered",
    "refit": false
   }
  ],
  "on": "light"
